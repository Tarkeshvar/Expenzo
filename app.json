{
  "expo": {
    "name": "Expenzo",
    "slug": "expenzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F7F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarkeshvar.expenzo"
    },
    "android": {
      "package": "com.tarkeshvar.expenzo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F7F4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ef4b4c51-62d8-437d-a1e3-778426eff6cc"
      }
    }
  }
}
